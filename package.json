    "pg": "^8.23.0",
    "simple-icons": "^16.31.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "go": "expo start --go",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "db:verify": "node scripts/verify-database.mjs",
    "catalog:import": "node scripts/import-catalog.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "catalog:musicbrainz": "node scripts/run-musicbrainz-catalog.mjs",
    "catalog:curated": "node scripts/run-curated-catalog.mjs",
    "analysis:prepare": "node scripts/run-song-intelligence.mjs --prepare-only",
    "analysis:full": "node scripts/run-song-intelligence.mjs --start",
    "analysis:report": "node scripts/report-song-intelligence.mjs",
    "recommendation:embed": "node scripts/generate-recommendation-embeddings.mjs",
    "recommendation:evaluate": "node scripts/evaluate-recommendations.mjs",
    "recommendation:verify": "node scripts/verify-recommendation-security.mjs",
    "recommendation:test-access": "node scripts/grant-recommendation-test-access.mjs",
    "recommendation:switch": "node scripts/set-recommendations-enabled.mjs",
    "recommendation:real-world": "node scripts/run-real-world-recommendations.mjs",
    "recommendation:no-match-live": "node scripts/test-no-strong-match-live.mjs",
    "security:prelaunch": "node scripts/verify-prelaunch-hardening.mjs",
    "security:cross-account": "node scripts/live-cross-account-security.mjs",
    "security:deployed": "node scripts/verify-deployed-prelaunch.mjs",
    "security:dependencies": "node scripts/audit-dependencies.mjs",
    "security:secrets": "node scripts/scan-production-secrets.mjs",
    "export:web": "expo export --platform web",
    "export:all": "expo export --platform all"
