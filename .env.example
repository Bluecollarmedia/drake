# Public client configuration only. Copy to .env.local and supply your project values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# UI readiness only, not a security gate. Enable after hosted OTP templates and redirects are configured.
EXPO_PUBLIC_EMAIL_OTP_READY=false
# UI availability only, never entitlement authority. Enable only in a native build after App Store and server setup.
EXPO_PUBLIC_APPLE_PURCHASES_ENABLED=false
# Never put database passwords, service-role keys, or provider secrets in EXPO_PUBLIC_* variables.
